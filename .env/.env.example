# === ThitNueaHub Secret Key Parameters ===
TNH_SECRET_KEY=your_secure_hmac_secret_token_here

# === Cloudflare Edge Deployment Configurations ===
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here

# === Telemetry & Security Mode ===
TNH_SECURITY_LEVEL=MAXIMUM
TNH_TRACING_MODE=RECORD_UNTIL_FULL
