# === ThitNueaHub Fortress Android Network Configuration ===
# พอร์ตหลักของเครื่องยนต์ประมวลผลสตูดิโอออฟไลน์
TNH_PORT=:2026

# === Timeline Orchestrator Parameters (Milliseconds) ===
# กฎการหน่วงเวลาประมวลผลโครงสร้างฉากภาพยนตร์ (3s-5s-7s Setup)
TNH_HOOK_DELAY_MS=30
TNH_CONFLICT_DELAY_MS=50
TNH_EMOTION_DELAY_MS=70

# === System Security & Queue Threshold ===
# ขีดจำกัดสูงสุดของท่อรับคิวก่อนที่ระบบจะส่งสัญญาณ Queue Full
TNH_MAX_QUEUE_SIZE=64
TNH_SECURITY_INTEGRITY=MAXIMUM
